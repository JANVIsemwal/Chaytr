# Copy this file to .env and fill in what you need. Everything is optional for local development.

# Port the API listens on
PORT=4000

# Company name used in emails
APP_NAME=Chaytr

# Public address of the website (used for links in password-reset emails)
APP_URL=http://localhost:8081

# Website origins allowed to call the API, comma separated
CORS_ORIGIN=http://localhost:8081

# Set to production when deployed (turns on secure cookies)
# NODE_ENV=production

# Email sending (password reset). Leave SMTP_HOST empty to print emails in the console instead.
# Works with Gmail (app password), Zoho, Brevo, SendGrid, Amazon SES, Resend SMTP, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Chaytr <no-reply@yourdomain.com>

# Optional: also email new contact-form messages to this address
CONTACT_TO=
